---
import Base from "../layouts/Base.astro";
import Paper from "../components/Paper.astro";
import Photo from "../components/Photo.astro";
import Slot from "../components/Slot.astro";
import AvailabilityCalendar from "../components/AvailabilityCalendar.astro";
import {
  bookableServices, availability,
  rateLines, deposit, paymentMethods, cancellationPolicy, leadTime,
  intakeFields, intakeFor,
} from "../data/booking";
import { BOOKING_ENDPOINT } from "../lib/booking-api";
import { site } from "../data/site";

/* Sending is on once the Apps Script endpoint is pasted into
   booking-api.ts. Read at BUILD time so a site with no endpoint ships
   the button already disabled, rather than enabling it and failing in
   front of a client. */
const live = BOOKING_ENDPOINT !== "";
/* Which intake set each service needs, resolved once at build time from
   booking.ts so the page and the data cannot drift apart. */
const intakeKindFor = Object.fromEntries(
  bookableServices.map((s) => [s.slug, intakeFor(s.slug)]),
);
---

<Base
  title="Book a Session"
  description="Book studio time with Liz Loya — recording, mixing, production, or DJ and event bookings in Dallas."
  ogImage="/media/img/console-standing-1200.jpg"
>
  {/* The photo used to be a full-bleed background under a 88% white veil:
      a whole screen of washed-out image before anyone reached the form.
      Now it is a normal picture sitting beside the heading — visible as a
      photograph rather than as wallpaper, and a third of the height. */}
  <section class="bk-hero">
    <div class="wrap bk-hero__in">
      <div class="bk-hero__txt">
        <p class="kicker">Booking</p>
        <h1 class="display bk-hero__h">Book a session</h1>
        <p class="bk-hero__lede">
          Recording, mixing, production, or a set for your event.
          Fill this in and I'll come back to you.
        </p>
      </div>
      <figure class="bk-hero__shot">
        <Photo name="console-moody" alt="Liz at the console" sizes="(min-width: 60rem) 24rem, 88vw" loading="eager" fetchpriority="high" />
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="wrap bk__grid">
      <!-- ─── THE SLIP ──────────────────────────────────────── -->
      <Paper rot={-0.6} tone="cream" class="slip" tape={false}>
        <div class="slip__head">
          <span class="slip__ttl display">Session request</span>
          <span class="slip__no typewriter">NO. ______</span>
        </div>

        {/* method="post" matters even with no endpoint: the default GET
            would put name, email and phone into the URL if JS ever fails
            to load. Native validation is left ON so the form still
            validates with JS disabled. */}
        <form class="form" id="booking" method="post">
          <fieldset class="fs">
            <legend class="fs__lg typewriter">1 &mdash; What do you need?</legend>

            <div class="f">
              <label class="f__l" for="service">Service</label>
              <select class="f__c" id="service" name="service" required>
                <option value="">Choose one&hellip;</option>
                {bookableServices.map((s) => (
                  <option
                    value={s.slug}
                    data-price={s.price ?? ""}
                    data-kind={intakeKindFor[s.slug] ?? "none"}
                  >
                    {s.label}{s.price ? ` — ${s.price}` : ""}
                  </option>
                ))}
              </select>
            </div>

            <div class="f">
              <span class="f__l" id="price-l">Rate</span>
              <p class="f__price typewriter" id="price" aria-labelledby="price-l" aria-live="polite">
                Pick a service to see the rate.
              </p>
              <ul class="rates typewriter">
                {rateLines.map((r) => (
                  <li>
                    <b>{r.label}</b> <span class="rates__p">{r.price}</span>
                    {r.note && <em class="rates__n">{r.note}</em>}
                  </li>
                ))}
              </ul>
            </div>
          </fieldset>

          <fieldset class="fs">
            <legend class="fs__lg typewriter">2 &mdash; When?</legend>

            {/* Phase 2: real openings, read straight from the database.
                Only appears for the services she takes straight through;
                for everything else the plain fields below are the request.
                With JS off it never renders and the fields still work. */}
            <AvailabilityCalendar />

            <div class="f2">
              <div class="f">
                <label class="f__l" for="date">Preferred date</label>
                <input class="f__c" type="date" id="date" name="date" required />
              </div>
              <div class="f">
                <label class="f__l" for="time">Preferred time</label>
                <input class="f__c" type="time" id="time" name="time" required
                       min={availability.earliest} max={availability.latest}
                       aria-describedby="avail-note" />
              </div>
            </div>

            <p class="f__hint typewriter" id="avail-note">
              {availability.closedNote} {leadTime.label.studio} {leadTime.label.event}{" "}
              Recording and consult calls show her real openings above.
              Everything else I confirm by hand.
            </p>
          </fieldset>

          <fieldset class="fs">
            <legend class="fs__lg typewriter">3 &mdash; Who are you?</legend>

            <div class="f">
              <label class="f__l" for="name">Name</label>
              <input class="f__c" type="text" id="name" name="name"
                     autocomplete="name" required />
            </div>
            <div class="f2">
              <div class="f">
                <label class="f__l" for="email">Email</label>
                <input class="f__c" type="email" id="email" name="email"
                       autocomplete="email" required />
              </div>
              <div class="f">
                <label class="f__l" for="phone">Phone</label>
                <input class="f__c" type="tel" id="phone" name="phone"
                       autocomplete="tel" required />
              </div>
            </div>
          </fieldset>

          {/* Q29 — she answered "all", so every one of these is required.
              Both sets render; JS disables the one that does not apply, and
              a disabled field is excluded from validation and submission.
              With JS off both sets show and both are answerable. */}
          <fieldset class="fs" data-intake="studio">
            <legend class="fs__lg typewriter">4 &mdash; About the session</legend>
            {intakeFields.studio.map((f) => (
              <div class="f">
                <label class="f__l" for={`i-${f.id}`}>{f.label}</label>
                {f.type === "yesno" ? (
                  <select class="f__c" id={`i-${f.id}`} name={f.id} required>
                    <option value="">Choose one&hellip;</option>
                    <option value="yes">Yes</option>
                    <option value="no">No</option>
                  </select>
                ) : (
                  <input class="f__c" id={`i-${f.id}`} name={f.id} required
                         type={f.type === "number" ? "number" : "text"}
                         min={f.type === "number" ? "1" : undefined} />
                )}
              </div>
            ))}
          </fieldset>

          {/* Ships hidden AND disabled: `hidden` alone does not exempt a
              field from constraint validation, so without `disabled` a no-JS
              visitor hits an unfocusable required field and the form refuses
              to submit with nothing shown. JS enables whichever set applies. */}
          <fieldset class="fs" data-intake="event" hidden disabled>
            <legend class="fs__lg typewriter">4 &mdash; About the event</legend>
            {intakeFields.event.map((f) => (
              <div class="f">
                <label class="f__l" for={`e-${f.id}`}>{f.label}</label>
                {f.type === "yesno" ? (
                  <select class="f__c" id={`e-${f.id}`} name={f.id} required>
                    <option value="">Choose one&hellip;</option>
                    <option value="yes">Yes</option>
                    <option value="no">No</option>
                  </select>
                ) : (
                  <input class="f__c" id={`e-${f.id}`} name={f.id} required
                         type={f.type === "number" ? "number" : f.type === "date" ? "date" : "text"}
                         data-lead={f.type === "date" ? "event" : undefined}
                         min={f.type === "number" ? "1" : undefined} />
                )}
              </div>
            ))}
          </fieldset>

          <fieldset class="fs">
            <legend class="fs__lg typewriter">5 &mdash; The project</legend>
            <div class="f">
              <label class="f__l" for="project">Tell me about it</label>
              <textarea class="f__c f__ta" id="project" name="project" rows="5"
                        required
                        placeholder="What are you making, how far along is it, and what do you need from the session?"></textarea>
            </div>
          </fieldset>

          {/* Honeypot. Never rendered to a person: off-screen, not
              focusable, not required, hidden from assistive tech. A bot
              fills every input it can find, and the Apps Script drops
              any request that arrives with this filled in. Positioned
              off-screen rather than display:none because some bots skip
              anything that is display:none — which is the whole point
              of the trap. */}
          <div class="hp" aria-hidden="true">
            <label for="website">Website</label>
            <input type="text" id="website" name="website"
                   tabindex="-1" autocomplete="off" />
          </div>

          <div class="act">
            <button class="btn btn--primary" type="submit" id="review">
              Review request
            </button>
            <button class="btn btn--ghost" type="submit" id="send"
                    disabled={!live} aria-describedby="send-note">
              Send request
            </button>
          </div>

          <p class="act__note typewriter" id="send-note">
            {live
              ? "Your request goes to Liz. She confirms the date and time before anything is held."
              : "Sending is switched off: the booking sheet is not connected yet, so there is nowhere for this to go. Review still works and shows exactly what would be sent."}
          </p>

          <output class="out" id="out" hidden></output>
        </form>
      </Paper>

      <!-- ─── SIDEBAR ───────────────────────────────────────── -->
      <aside class="side">
        <Paper rot={1.4} tone="index" class="side__card">
          <p class="kicker">What happens next</p>
          <ol class="side__steps typewriter">
            <li>You send the request.</li>
            <li>I confirm the date and time.</li>
            <li>You pay a {deposit.percent}% deposit to hold the slot.</li>
            <li>You come in and work.</li>
          </ol>
        </Paper>

        <Paper rot={-1.1} tone="cream" class="side__card">
          <p class="kicker">Deposit &amp; payment</p>
          <p class="side__big display">{deposit.percent}%</p>
          <p class="side__p">
            due to hold your date, and it is non-refundable.
            {" "}{deposit.balanceDue}
          </p>
          <p class="side__pay typewriter">
            {paymentMethods.join(" · ")}
          </p>
        </Paper>

        <Paper rot={0.9} tone="index" class="side__card">
          <p class="kicker">If plans change</p>
          <ul class="side__policy typewriter">
            {cancellationPolicy.map((line) => <li>{line}</li>)}
          </ul>
        </Paper>

        <div class="side__slots">
          {live ? (
            <p class="side__fallback typewriter">
              Prefer email? <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>.
            </p>
          ) : (
            <>
              <Slot label="CONNECT THE BOOKING SHEET"
                    note="Where requests are received and confirmed." size="sm" />
              <p class="side__fallback typewriter">
                Booking is not switched on yet &mdash; until it is, email
                {" "}<a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>.
              </p>
            </>
          )}
        </div>
      </aside>
    </div>
  </section>
</Base>

<script>
  import {
    fetchServices, buildPayload, submitBooking, writeConfigured,
    BOOKING_COLUMNS,
  } from "../lib/booking-api";
  import { site } from "../data/site";

  /* An Astro <script> is a module of its own and cannot read the
     frontmatter above, so the address comes from the same file the
     frontmatter reads. Hardcoding it here is how it ends up out of date
     in exactly one of the two places. */
  const MAIL = site.contact.email;

  /* Progressive enhancement only. With JS off the fields still validate
     natively and "Send request" stays disabled — nothing here is required
     to understand or fill in the form. */
  function initBooking() {
  const form = document.getElementById("booking") as HTMLFormElement | null;
  const out = document.getElementById("out") as HTMLOutputElement | null;

  /* Show only the intake set that matches the service, and set the
     earliest bookable date from the lead time for that kind of work.
     A hidden set is DISABLED, not just hidden — otherwise its required
     fields would block submission invisibly. */
  const svc = document.getElementById("service") as HTMLSelectElement | null;
  const price = document.getElementById("price");
  const dateEl = document.getElementById("date") as HTMLInputElement | null;
  const sets = Array.from(
    document.querySelectorAll<HTMLFieldSetElement>("[data-intake]")
  );

  function applyService() {
    if (!svc) return;
    const opt = svc.selectedOptions[0];
    const kind = opt?.dataset.kind ?? "studio";
    const p = opt?.dataset.price ?? "";

    if (price) {
      price.textContent = svc.value
        ? (p || "Quoted per project — tell me what you need below.")
        : "Pick a service to see the rate.";
    }

    for (const fsEl of sets) {
      const on = svc.value !== "" && fsEl.dataset.intake === kind;
      fsEl.hidden = !on;
      fsEl.disabled = !on;
    }

    const days = kind === "event" ? 14 : 1;
    /* Format in LOCAL time. toISOString() is UTC, so west of Greenwich an
       evening visitor was pushed a whole extra day out. */
    const d = new Date();
    d.setDate(d.getDate() + days);
    const min = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
    if (dateEl) dateEl.min = min;
    /* The event fieldset has its own date field; the lead time has to apply
       there too or the two-week rule is trivially bypassed. */
    document.querySelectorAll<HTMLInputElement>('[data-lead="event"]')
      .forEach((el) => { el.min = min; });
  }

  if (svc) {
    for (const fsEl of sets) { fsEl.hidden = true; fsEl.disabled = true; }
    svc.addEventListener("change", applyService);
    applyService();
  }

  if (form && out) {
    const sendBtn = document.getElementById("send") as HTMLButtonElement | null;
    let inFlight = false;

    const esc = (v: unknown) =>
      String(v ?? "").replace(/[<>&]/g, (c) =>
        ({ "<": "&lt;", ">": "&gt;", "&": "&amp;" })[c] as string);

    /* FormData -> a plain object. Disabled fieldsets contribute nothing,
       which is exactly right: the intake set that does not apply to this
       service is disabled, so its answers never reach the sheet. */
    function readForm(): Record<string, string> {
      const out: Record<string, string> = {};
      for (const [k, v] of new FormData(form!).entries()) out[k] = String(v);
      return out;
    }

    /* One table, used by BOTH the preview and the sent confirmation, and
       built from the same buildPayload() the network call uses. That is
       what makes "this is exactly what would be sent" true rather than a
       claim — if the two ever drift, this is the line that stops it. */
    function table(payload: Record<string, string>) {
      return '<dl class="out__dl">' +
        BOOKING_COLUMNS
          .filter((k) => String(payload[k] ?? "").trim() !== "")
          .map((k) => `<dt>${esc(k)}</dt><dd>${esc(payload[k])}</dd>`)
          .join("") +
        "</dl>";
    }

    function show(html: string) {
      out!.hidden = false;
      out!.innerHTML = html;
      out!.scrollIntoView({ behavior: "smooth", block: "nearest" });
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (inFlight) return;                     // double-click guard

      /* Which button submitted. Both are type=submit so that native
         validation runs for both — a review of an invalid form is not
         worth showing. */
      const wantsToSend =
        (e.submitter as HTMLElement | null)?.id === "send";

      const raw = readForm();
      const services = await fetchServices();
      const service = services.find((s) => s.slug === raw.service);
      const payload = buildPayload(raw, service);

      if (!wantsToSend || !writeConfigured()) {
        show(
          '<p class="out__h typewriter">This is exactly what would be sent:</p>' +
          table(payload) +
          '<p class="out__n typewriter">' +
          (writeConfigured()
            ? "Nothing sent yet — press Send request when you're ready."
            : "Not sent — the booking sheet is not connected.") +
          "</p>",
        );
        return;
      }

      inFlight = true;
      const label = sendBtn?.textContent ?? "Send request";
      if (sendBtn) { sendBtn.disabled = true; sendBtn.textContent = "Sending…"; }
      show('<p class="out__h typewriter">Sending…</p>');

      const res = await submitBooking(payload);

      if (res.ok) {
        /* Deliberately does NOT say the slot is booked or held. The
           calendar means "she's probably free then"; she confirms by
           hand, and the deposit is what actually holds a date. Saying
           anything stronger here would be the site making a promise she
           has not made. */
        show(
          '<p class="out__h out__ok typewriter">Request sent.</p>' +
          '<p class="out__p">Liz will confirm your date and time, then you pay the ' +
          '50% deposit to hold it. Nothing is held until she confirms.</p>' +
          '<p class="out__h typewriter">What you sent:</p>' +
          table(payload),
        );
        form!.querySelectorAll<HTMLButtonElement>("button[type=submit]")
          .forEach((b) => { b.disabled = true; });
        if (sendBtn) sendBtn.textContent = "Sent";
        return;
      }

      /* Failure has to be loud and has to give them a way through, or
         the request is simply lost and neither of them ever knows. */
      console.error("[booking] submit failed", res.error);
      show(
        '<p class="out__h out__bad typewriter">That didn\u2019t go through.</p>' +
        '<p class="out__p">Nothing was sent. Please try again, or email ' +
        '<a href="mailto:' + MAIL + '">' + MAIL + '</a> and paste the ' +
        "details below \u2014 you won't have to type it all again.</p>" +
        table(payload),
      );
      inFlight = false;
      if (sendBtn) { sendBtn.disabled = false; sendBtn.textContent = label; }
    });
  }
  }
  /* Fires on first load AND after every client-side navigation. Without
     this the form is inert on any visit reached through an in-site link. */
  document.addEventListener("astro:page-load", initBooking);
</script>

<style>
  .bk-hero { padding-block: var(--s-6) var(--s-5); }
  .bk-hero__in {
    display: grid; gap: var(--s-5); align-items: center;
  }
  @media (min-width: 60rem) {
    /* Text takes the room it needs; the photo is a fixed, modest 24rem
       so it can never grow into a hero again. */
    .bk-hero__in { grid-template-columns: minmax(0, 1fr) 24rem; gap: var(--s-7); }
  }
  .bk-hero__txt { min-width: 0; }
  .bk-hero__h { font-size: var(--t-2xl); margin-block: var(--s-2) var(--s-3); }
  .bk-hero__lede { color: var(--text-2); max-width: 34rem; margin: 0; }

  .bk-hero__shot {
    margin: 0; justify-self: start; min-width: 0;
    /* Sits like something taped into the scrapbook rather than a banner. */
    border: 1px solid var(--line, rgba(0,0,0,.15));
    padding: .5rem .5rem 1.6rem;
    background: var(--paper, #fdf9f8);
    box-shadow: 0 1px 0 rgba(0,0,0,.05), 0 12px 26px -18px rgba(0,0,0,.5);
    transform: rotate(-1.1deg);
  }
  @media (min-width: 60rem) { .bk-hero__shot { justify-self: end; } }
  .bk-hero__shot :global(img) {
    display: block; width: 100%; height: auto;
    aspect-ratio: 4 / 3; object-fit: cover;
  }
  @media (prefers-reduced-motion: reduce) { .bk-hero__shot { transform: none; } }

  .bk__grid { display: grid; gap: var(--s-7); align-items: start; }
  @media (min-width: 64rem) {
    /* minmax(0, …) not plain fr: a grid track defaults to min-width:auto,
       so any wide child (the calendar's day strip) pushes the column past
       its share and out under the next one instead of scrolling. */
    .bk__grid { grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.75fr); gap: var(--s-8); }
  }

  /* THE SLIP */
  .bk__grid :global(.slip) { max-width: 46rem; }
  .slip__head {
    display: flex; justify-content: space-between; align-items: baseline;
    gap: var(--s-4); padding-bottom: var(--s-3);
    border-bottom: 2px solid var(--paper-ink);
    margin-bottom: var(--s-5);
  }
  .slip__ttl { font-size: var(--t-lg); color: var(--paper-ink); }
  .slip__no { font-size: var(--t-xs); color: var(--paper-ink-soft); letter-spacing: .16em; }

  .rates {
    list-style: none; margin: var(--s-2) 0 0; padding: 0;
    display: grid; gap: var(--s-1); font-size: var(--t-xs);
    color: var(--paper-ink-soft);
  }
  .rates li { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--s-2); }
  .rates b { color: var(--paper-ink); font-weight: 700; }
  .rates__p { color: var(--pink-deep); font-weight: 700; }
  .rates__n { font-style: normal; opacity: .8; }

  .side__big {
    font-size: var(--t-xl); color: var(--pink-deep);
    line-height: 1; margin: var(--s-2) 0 var(--s-1);
  }
  .side__p { color: var(--paper-ink-soft); font-size: var(--t-sm); margin: 0; }
  .side__pay {
    margin-top: var(--s-3); font-size: var(--t-xs);
    letter-spacing: .08em; color: var(--paper-ink);
  }
  .side__policy {
    margin: var(--s-3) 0 0; padding-left: var(--s-4);
    font-size: var(--t-xs); color: var(--paper-ink-soft);
    display: grid; gap: var(--s-2);
  }
  .side__fallback {
    font-size: var(--t-xs); color: var(--text-2); margin-top: var(--s-3);
  }
  .side__fallback a { color: var(--pink-deep); }

  /* min-width:0 all the way down, same reason as the grid tracks above:
     without it every one of these grid items refuses to shrink below its
     widest child and the overflow never reaches the element that scrolls. */
  .form { display: grid; gap: var(--s-6); min-width: 0; }
  .fs { border: 0; margin: 0; padding: 0; display: grid; gap: var(--s-4); min-width: 0; }
  /* ═══ REAL BUG, FOUND ON THE LIVE SITE 2026-09-04 ═══
     `hidden` works by a USER-AGENT rule, [hidden] { display: none }, and
     any AUTHOR rule that sets display beats it. `.fs { display: grid }`
     above was doing exactly that, so BOTH intake sets rendered at once no
     matter what the script set — an artist booking a mix was being asked
     for a venue and a guest count. Same for `.out { display: block }`,
     which meant the "here is what would be sent" preview showed on load.
     Setting the attribute in JS was never enough; the CSS has to yield. */
  .fs[hidden], .out[hidden] { display: none; }
  .fs__lg {
    font-size: var(--t-xs); letter-spacing: .2em; text-transform: uppercase;
    color: var(--paper-ink-soft); padding: 0; margin-bottom: var(--s-2);
  }
  .f { display: grid; gap: var(--s-2); }
  .f2 { display: grid; gap: var(--s-4); }
  @media (min-width: 34rem) { .f2 { grid-template-columns: 1fr 1fr; } }

  .f__l {
    font-family: var(--font-type); font-size: var(--t-xs);
    letter-spacing: .12em; text-transform: uppercase; color: var(--paper-ink);
  }
  .f__c {
    font-family: var(--font-sans); font-size: var(--t-base);
    color: var(--paper-ink); background: transparent;
    border: 0; border-bottom: 1.5px solid var(--paper-ink-soft);
    padding: var(--s-2) var(--s-1); min-height: 44px; width: 100%;
  }
  .f__c:focus-visible {
    outline: 3px solid var(--violet); outline-offset: 2px;
    background: rgba(111,79,242,.06);
  }
  /* Not colour alone — WCAG 1.4.1. The border also thickens and the field
     tints, so the state survives colour-blindness and greyscale. */
  .f__c:user-invalid {
    border-bottom-color: #b4232a;
    border-bottom-width: 3px;
    background-color: #fdf0f0;
  }
  .f__ta { min-height: 8rem; resize: vertical; line-height: 1.5; }
  .f__price, .f__hint {
    margin: 0; font-size: var(--t-xs); color: #8a5a00; font-weight: 700;
  }
