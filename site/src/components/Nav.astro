---
import { u } from "../lib/url";
import { nav, site } from "../data/site";

interface Props {
  pageNumber?: string;
  pageTitle?: string;
}

const { pageNumber = "—", pageTitle = "Feature" } = Astro.props;
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const at = (href: string) => {
  const based = u(href).replace(/\/+$/, "") || "/";
  return path === based || (href === "/archive" && path.startsWith(`${based}/`));
};

const contents = [
  { href: "/", label: "Cover", num: "—" },
  { href: "/#p1", label: "Contents", num: "02" },
  ...nav.filter((item) => item.href !== "/").map((item, index) => ({
    ...item,
    num: String(index + 3).padStart(2, "0"),
  })),
];
---

<header class="issue-bar" data-issue-bar>
  <a class="issue-logo display" href={u("/")}>{site.name}</a>
  <span class="issue-where typewriter">Issue 01 · p. {pageNumber} <b>{pageTitle}</b></span>

  <button class="issue-pill issue-sound typewriter" type="button" aria-pressed="false" aria-label="Play LOYA's music">
    <span aria-hidden="true">♪</span> Sound
  </button>

  <details class="issue-menu">
    <summary class="issue-pill typewriter">Contents <span aria-hidden="true">▾</span></summary>
    <div class="issue-menu__sheet">
      <ol>
        {contents.map((item, index) => (
          <li style={`--i:${index};`}>
            <a href={u(item.href)} aria-current={at(item.href) ? "page" : undefined}>
              <b class="display">{item.num}</b>
              <span>{item.label}</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </details>

  <a class="issue-pill issue-book typewriter" href={u("/book")}>Book</a>
</header>

<script>
  let releaseIssueNav = () => {};

  function bindIssueNav() {
    releaseIssueNav();
    const bar = document.querySelector<HTMLElement>("[data-issue-bar]");
    if (!bar) return;

    const control = new AbortController();
    const { signal } = control;
    const menu = bar.querySelector<HTMLDetailsElement>(".issue-menu");
    const sound = bar.querySelector<HTMLButtonElement>(".issue-sound");
    const audio = document.getElementById("site-audio") as HTMLAudioElement | null;

    const syncSound = () => {
      const on = audio?.paused === false;
      sound?.setAttribute("aria-pressed", String(on));
      sound?.setAttribute("aria-label", `${on ? "Pause" : "Play"} LOYA's music`);
    };

    sound?.addEventListener("click", () => {
      const dockButton = document.getElementById("site-audio-btn") as HTMLButtonElement | null;
      dockButton?.click();
      requestAnimationFrame(syncSound);
    }, { signal });
    audio?.addEventListener("play", syncSound, { signal });
    audio?.addEventListener("pause", syncSound, { signal });
    syncSound();

    bar.querySelectorAll(".issue-menu a").forEach((link) => {
      link.addEventListener("click", () => { if (menu) menu.open = false; }, { signal });
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && menu?.open) {
        menu.open = false;
        menu.querySelector("summary")?.focus();
      }
    }, { signal });
    document.addEventListener("pointerdown", (event) => {
      if (menu?.open && !menu.contains(event.target as Node)) menu.open = false;
    }, { signal });

    releaseIssueNav = () => control.abort();
  }

  document.addEventListener("astro:page-load", bindIssueNav);
  document.addEventListener("astro:before-swap", () => releaseIssueNav());
  bindIssueNav();
</script>

<style>
  .issue-bar {
    position: sticky;
    top: 0;
    z-index: 60;
    min-height: 4.25rem;
    display: flex;
    align-items: center;
    gap: .75rem;
    padding: calc(.65rem + env(safe-area-inset-top, 0px)) clamp(1rem, 3vw, 2.5rem) .65rem;
    background: color-mix(in srgb, var(--ground-2) 88%, transparent);
    border-bottom: 1px solid rgba(31, 23, 32, .14);
    backdrop-filter: blur(14px);
  }

  .issue-logo {
    color: var(--text-1);
    font-size: 1.75rem;
    letter-spacing: .01em;
    text-decoration: none;
  }

  .issue-where {
    min-width: 0;
    flex: 1;
    overflow: hidden;
    color: var(--text-2);
    font-size: .72rem;
    letter-spacing: .12em;
    text-overflow: ellipsis;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .issue-where b { color: var(--pink-deep); }

  .issue-pill {
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .5rem;
    padding: .7rem 1rem;
    color: var(--text-1);
    background: var(--paper-100);
    border: 2px solid var(--text-1);
    border-radius: 99px;
    font-size: .72rem;
    font-weight: 700;
    letter-spacing: .1em;
    text-decoration: none;
    text-transform: uppercase;
    cursor: pointer;
  }
  .issue-pill:hover,
  .issue-pill:focus-visible { background: var(--paper-300); }
  .issue-sound[aria-pressed="true"] { color: var(--paper-100); background: var(--text-1); }

  .issue-book {
    color: #fff;
    background: var(--pink);
    border-color: var(--pink);
    box-shadow: 0 3px 0 var(--pink-deep);
  }
  .issue-book:hover,
  .issue-book:focus-visible { color: #fff; background: var(--pink-deep); }

  .issue-menu { position: relative; }
  .issue-menu summary { list-style: none; }
  .issue-menu summary::-webkit-details-marker { display: none; }
  .issue-menu[open] summary { color: var(--paper-100); background: var(--text-1); }

  .issue-menu__sheet {
    position: absolute;
    top: calc(100% + .55rem);
    right: 0;
    width: max-content;
    min-width: 17rem;
    max-width: calc(100vw - 2rem);
    max-height: calc(100vh - 6rem);
    overflow-y: auto;
    padding: .55rem;
    background: var(--paper-100);
    border: 2px solid var(--text-1);
    box-shadow: 6px 6px 0 var(--pink);
    transform-origin: 100% 0;
    animation: issue-menu-in .22s var(--ease-out);
  }

  @keyframes issue-menu-in {
    from { opacity: 0; transform: translateY(-6px) scale(.97); }
  }

  .issue-menu ol { list-style: none; margin: 0; padding: 0; }
  .issue-menu li {
    animation: issue-item-in .3s var(--ease-out) backwards;
    animation-delay: calc(var(--i) * 22ms);
  }
  @keyframes issue-item-in {
    from { opacity: 0; transform: translateX(.5rem); }
  }

  .issue-menu a {
    display: grid;
    grid-template-columns: 2.7rem 1fr;
    align-items: baseline;
    gap: .35rem;
    padding: .65rem .75rem;
    color: var(--text-1);
    font-size: .9rem;
    font-weight: 700;
    text-decoration: none;
  }
  .issue-menu a:hover,
  .issue-menu a:focus-visible,
  .issue-menu a[aria-current="page"] { background: var(--ground-2); }
  .issue-menu a b { color: var(--pink-deep); font-size: 1.2rem; }

  @media (max-width: 47rem) {
    .issue-bar { gap: .45rem; padding-inline: .7rem; }
    .issue-where { display: none; }
    .issue-logo { margin-right: auto; }
    .issue-pill { min-height: 2.55rem; padding: .58rem .72rem; font-size: .65rem; }
  }

  @media (max-width: 28rem) {
    .issue-sound { width: 2.7rem; padding-inline: 0; font-size: 0; }
    .issue-sound span { font-size: .9rem; }
    .issue-book { display: none; }
    .issue-menu__sheet { position: fixed; top: 4.4rem; right: .65rem; left: .65rem; width: auto; }
  }

  @media (prefers-reduced-motion: reduce) {
    .issue-menu__sheet,
    .issue-menu li { animation: none; }
  }
</style>
